{
  "name": "js-hwp",
  "version": "0.0.1",
  "private": true,
  "description": "Read, write and edit Hangul (HWP) word processor documents in pure TypeScript",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "hwp",
    "hangul",
    "hancom",
    "korean",
    "word-processor",
    "document"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --tsconfig ../../tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@js-hwp/core": "0.0.2",
    "@js-hwp/hwp": "0.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juyeongnoh/js-hwp.git",
    "directory": "packages/js-hwp"
  },
  "homepage": "https://github.com/juyeongnoh/js-hwp#readme",
  "bugs": {
    "url": "https://github.com/juyeongnoh/js-hwp/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
