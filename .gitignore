node_modules/
dist/
out/
build/
coverage/
*.tsbuildinfo
.tsbuildinfo/
.DS_Store
.env
.env.local
*.log
apps/editor/release/
scratch/

# This repository uses npm. A second lock file means two answers to
# "which versions does this project use", and contributors silently get
# different dependency trees from the same source.
pnpm-lock.yaml
yarn.lock
bun.lockb
bun.lock

# Benchmark build products: the Rust probe's target directory and the
# generated node:zlib shim are rebuilt by bench/README.md's instructions.
bench/rust-probe/target/
bench/lib/hwpx-native.mjs
bench/lib/fflate-native.mjs

# Python bytecode from tools/spec-transcribe.
__pycache__/

# Claude Code
CLAUDE.md
.claude/

# ─────────────────────────────────────────────────────────────────────────
# 첫 저장소는 라이브러리 소스와 그것을 빌드·배포하는 데 필요한 것만 담는다.
# 나머지는 로컬에 그대로 있고 추적만 하지 않는다. 필요해지는 순서대로 이
# 목록에서 빼면서 올린다.
# ─────────────────────────────────────────────────────────────────────────

# 벤치마크, 예제, 빌드 보조 스크립트
bench/
examples/
scripts/

# 패키지 README는 문서가 아니라 배포물의 일부다. npm이 files와 무관하게
# 타르볼에 넣고, 레지스트리 페이지 본문이 된다. 저장소에 없으면 클론에서
# 같은 패키지를 다시 만들 수 없다.
!packages/*/README.md

# 테스트. 로컬에는 남아 있으므로 `npm test`는 여기서 그대로 돈다.
packages/*/test/
*.test.ts
vitest.config.ts

# 에디터 앱. 라이브러리가 아니다.
apps/

# 개발 도구. 라이브러리 코드가 아니다.
tools/

# CI와 릴리스 자동화. 위의 것들이 없으면 어느 잡도 통과할 수 없다.
.github/
.changeset/